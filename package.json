{
  "name": "gliffo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "build": "node scripts/build-dist.mjs",
    "build:daily-seed": "node scripts/build-daily-schedule-seed.mjs",
    "dev": "pnpm dlx live-server --port=8080 --no-browser --watch=.",
    "preview:dist": "pnpm dlx serve dist --listen 8080",
    "smoke:daily-word": "node scripts/smoke-daily-word.mjs",
    "smoke:daily-word:suite": "node scripts/smoke-daily-word-suite.mjs",
    "supabase:bootstrap-local": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap-local-supabase.ps1",
    "test:daily-word": "deno test --node-modules-dir=auto supabase/functions/daily-word --allow-env --allow-read",
    "start:python": "python -m http.server 8080"
  },
  "devDependencies": {
    "supabase": "^2.81.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "supabase"
    ]
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
